# Shopify Partner app (Autlantic-operated host)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://shopify.autlantic.com
SCOPES=read_orders,write_orders

# Encrypt shop tokens + Autlantic secrets at rest (any long random string)
TOKEN_ENCRYPTION_KEY=

# Postgres (required). Each Shopify store stores its own Autlantic merchant credentials.
DATABASE_URL=postgres://user:pass@host:5432/shopify
# DATABASE_SSL=false

PORT=3458

# Merchants do NOT use shared Autlantic env keys.
# Each store pastes API key / webhook secret / payout in /app/settings after OAuth install.
